# Google AI Studio API key -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Server
PORT=8080
HOST=0.0.0.0

# Engine: "gemini" (real) | "mock" (no API key needed, for demos & tests)
ENGINE=gemini

# Models
TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
TRANSLATE_MODEL=gemini-3.8-flash

# Live API sessions are capped (~10 min). Rotate before the cap to stream indefinitely.
SESSION_ROTATE_SECONDS=480

# Cost controls (USD per million tokens; used for the live cost meter)
COST_AUDIO_INPUT_PER_MTOK=0.50
COST_TEXT_INPUT_PER_MTOK=0.10
COST_TEXT_OUTPUT_PER_MTOK=0.40
