{
  "name": "transcribe-live",
  "version": "1.0.0",
  "description": "Open-source real-time transcription and ES/EN translation at scale for conferences.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/src/main.js",
    "smoke": "npm run build && node dist/scripts/smoke-gemini.js",
    "replay": "node dist/scripts/replay.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/",
    "ingest": "node dist/scripts/ingest.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsc-alias": "^1.9.5",
    "typescript": "^5.7.2"
  },
  "main": "dist/src/main.js"
}
